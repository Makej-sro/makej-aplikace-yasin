{
  "name": "makej-brigadnik",
  "version": "1.0.0",
  "private": true,
  "description": "Makej! — mobilní aplikace pro brigádníky (Capacitor obal webového rozhraní).",
  "scripts": {
    "serve": "python3 -m http.server 4000 --directory www",
    "sync": "cap sync",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "cap run ios",
    "run:android": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
